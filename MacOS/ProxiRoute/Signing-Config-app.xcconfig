// Configuration settings file format documentation can be found at:
// https://developer.apple.com/documentation/xcode/adding-a-build-configuration-file-to-your-project

// MARK: - Team Configuration
DEVELOPMENT_TEAM = L******* // update it

// MARK: - Main App Signing (ProxiRoute)
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
CODE_SIGN_ENTITLEMENTS = ProxiRoute/ProxiRouteRelease.entitlements
PRODUCT_BUNDLE_IDENTIFIER = com.sdpong.ProxiRoute
PRODUCT_MODULE_NAME = ProxiRoute
PRODUCT_NAME = ProxiRoute
PROVISIONING_PROFILE_SPECIFIER = ProxiRoute Prod

// MARK: - Additional Signing Settings
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_HARDENED_RUNTIME = YES

// MARK: - Architecture (Universal Binary: Intel + Apple Silicon)
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO


DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =
CODE_SIGN_IDENTITY =
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
