<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sdpong.proxiroute.helper</string>

    <!-- The helper is a program of root. It does the three things of the
         gateway mode that need root: the rules of the packet filter, the
         forwarding of the machine, and the question of where a redirected
         connection was going. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/com.sdpong.proxiroute.helper</string>
    </array>

    <!-- It is started when the machine starts, and it is put back when it
         stops for whatever reason. A helper that is not there cannot answer
         the app, and the app would say that the gateway mode is broken for a
         reason nobody can see. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- It runs as root: the device of the packet filter is for root alone,
         and so is the switch of the forwarding. -->
    <key>UserName</key>
    <string>root</string>
    <key>GroupName</key>
    <string>wheel</string>

    <!-- The socket it waits on lives in /var/run, and the helper needs to
         find its own tools. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- What it says is in the system log, where it can be read without the
         window of the app being open. -->
    <key>StandardOutPath</key>
    <string>/var/log/com.sdpong.proxiroute.helper.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/com.sdpong.proxiroute.helper.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
